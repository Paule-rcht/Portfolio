  <style>
    /* Fluid Editorial Animations & Custom Scrollbar */
    body {
      background-color: #F6F3EC;
      color: #1A1A1A;
      font-family: 'DM Sans', sans-serif;
      overflow-x: hidden;
    }

    .reveal {
      opacity: 0;
      transform: translateY(28px);
      transition: opacity 0.85s cubic-bezier(0.22, 1, 0.36, 1), transform 0.85s cubic-bezier(0.22, 1, 0.36, 1);
    }

    .reveal.is-visible {
      opacity: 1;
      transform: translateY(0);
    }

    .reveal-delay-1 { transition-delay: 0.12s; }
    .reveal-delay-2 { transition-delay: 0.24s; }
    .reveal-delay-3 { transition-delay: 0.36s; }

    /* Interactive Photo Slot Styling */
    .photo-slot {
      position: relative;
      overflow: hidden;
      cursor: pointer;
      transition: transform 0.35s cubic-bezier(0.22, 1, 0.36, 1), box-shadow 0.35s ease;
    }

    .photo-slot:hover {
      transform: translateY(-3px);
    }

    .photo-slot .slot-overlay {
      transition: opacity 0.25s ease, background-color 0.25s ease;
    }

    .photo-slot.has-image .slot-placeholder {
      opacity: 0;
      pointer-events: none;
    }

    .photo-slot.has-image .slot-overlay {
      opacity: 0;
    }

    .photo-slot.has-image:hover .slot-overlay {
      opacity: 1;
      background-color: rgba(20, 24, 29, 0.55);
    }

    /* Canva Blueprint Mode */
    body.blueprint-mode section {
      outline: 1px dashed rgba(217, 107, 67, 0.55);
      outline-offset: -8px;
    }

    .canva-badge {
      display: none;
    }

    body.blueprint-mode .canva-badge {
      display: inline-flex;
    }

    /* Subtle architectural grid texture */
    .blueprint-grid {
      background-image: radial-gradient(rgba(26, 26, 26, 0.08) 1px, transparent 1px);
      background-size: 20px 20px;
    }

    .blueprint-grid-dark {
      background-image: radial-gradient(rgba(255, 255, 255, 0.08) 1px, transparent 1px);
      background-size: 20px 20px;
    }
  </style>
